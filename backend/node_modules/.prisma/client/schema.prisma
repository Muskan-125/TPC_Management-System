// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role enum: STUDENT, COMPANY, ADMIN
enum Role {
  STUDENT
  COMPANY
  ADMIN
}

// Application status enum
enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
}

// User model
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  // A company can post many jobs
  jobs Job[] @relation("CompanyJobs")

  // A student can apply to many jobs
  applications Application[] @relation("StudentApplications")
}

// Job model
model Job {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  salary      String?
  location    String?
  companyId   Int
  company     User     @relation("CompanyJobs", fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  // A job can have many applications
  applications Application[] @relation("JobApplications")
}

// Application model
model Application {
  id        Int               @id @default(autoincrement())
  studentId Int
  student   User              @relation("StudentApplications", fields: [studentId], references: [id])
  jobId     Int
  job       Job               @relation("JobApplications", fields: [jobId], references: [id])
  status    ApplicationStatus @default(APPLIED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // Ensure a student can only apply once to the same job
  @@unique([studentId, jobId])
}
